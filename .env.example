# Copia este archivo como .env.local y rellena los valores.
# (.env.local no se sube a git)

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enlace de donaciones (PayPal.me, Ko-fi…). Vacío = sin botón de apoyo.
VITE_DONATE_URL=https://paypal.me/tu-usuario

# true SOLO al compilar para App Store / Google Play (oculta donaciones externas)
VITE_STORE_BUILD=false
